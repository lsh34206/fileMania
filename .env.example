# Used by docker-compose.yml for variable substitution ("docker compose" auto-loads a file
# literally named .env in this folder). Copy this to .env and fill in real values before
# running `docker compose up --build`.

# MongoDB Atlas connection string
MONGO_URI=

# TossPayments keys (get your own at https://developers.tosspayments.com)
TOSS_SECRET_KEY=
VITE_TOSS_CLIENT_KEY=

# Public origin the whole stack is served from (the nginx gateway's address).
# Change this to your real domain/IP when deploying anywhere but localhost.
PUBLIC_ORIGIN=http://localhost
